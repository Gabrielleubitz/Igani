// Igani CRM & scheduling platform (app.igani.co)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SALES
  MARKETING
}

enum LeadSourceType {
  COLD_CALL
  ADS
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  DEMO_SENT
  PROPOSAL_SENT
  /// The client signed the offer contract online; a down-payment invoice is due before it becomes Won
  SIGNED
  WON
  LOST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BookingSource {
  SALES_INVITE
  PUBLIC_PAGE
  /// internal team call (admins only), not tied to a contact
  TEAM_MEETING
}

enum EntityType {
  LEAD
  BOOKING
  USER
  ALLOWED_USER
  BOOKING_PAGE
  AVAILABILITY
  SETTING
  OFFER
}

// ─── Access control ──────────────────────────────────────────────────────────

/// Whitelist: only these emails may sign in. Role here is the source of truth.
model AllowedUser {
  id               String    @id @default(cuid())
  email            String    @unique
  role             Role
  active           Boolean   @default(true)
  /// Onboarding token emailed on invite (random, single-use)
  inviteToken      String?   @unique
  invitedAt        DateTime?
  inviteAcceptedAt DateTime?
  /// This salesperson's agreed commission terms (null = the defaults). Admin-only.
  commissionTerms  Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([role, active])
}

// ─── NextAuth (Prisma adapter) ───────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  role               Role?
  /// IANA zone for working hours, e.g. "Asia/Jerusalem"
  timeZone           String    @default("UTC")
  /// Round-robin cursor: rep with the oldest value gets the next lead
  lastLeadAssignedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  assignedLeads   Lead[]          @relation("LeadAssignee")
  hostBookings    Booking[]       @relation("BookingHost")
  createdBookings Booking[]       @relation("BookingCreator")
  availability    Availability[]
  bookingPages    BookingPage[]
  calendarEntries CalendarEntry[]
  activityLogs    ActivityLog[]
  agreements      Agreement[]
  leadArchives    LeadArchive[]
  leadNotes       LeadNote[]
  mailboxEmails   EmailMessage[]
  mailboxSync     MailboxSync?

  @@index([role])
}

/// Google OAuth tokens live here (access_token, refresh_token, expires_at, scope)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Lead {
  id                     String         @id @default(cuid())
  /// Null for phone-only leads (e.g. funnel forms that only ask for a phone number)
  email                  String?        @unique
  firstName              String?
  lastName               String?
  phone                  String?
  company                String?
  website                String?
  message                String?        @db.Text
  source                 String         @default("igani.co")
  /// Free text: which page/form/campaign/person the lead came from
  sourceDetail           String?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmTerm                String?
  utmContent             String?
  budget                 String?
  status                 LeadStatus     @default(NEW)
  /// Why a lead was LOST (required when moving to LOST)
  lostReason             String?
  /// Legacy deal value (no longer read; copied into quotedPrice by the 20261103 migration)
  dealValue              Int?
  /// The price agreed with the client after the sales call, whole currency units. Admin-only.
  quotedPrice            Int?
  currency               String         @default("ILS")
  /// Where the lead came from, for commission terms (admin-edited)
  sourceType             LeadSourceType @default(OTHER)
  /// Per-deal commission overrides set by an admin before the deal is won (null = use the salesperson's terms)
  commissionOverrides    Json?
  /// Terms + breakdown used when the deal was won. Never changes when the salesperson's terms change later. Admin-only.
  commissionSnapshot     Json?
  /// The salesperson's commission in whole shekels. This, with the two payment dates, is all a salesperson ever sees.
  commissionTotal        Int?
  /// The client paid us (admin enters the date): the commission is only payable from here
  finalPaymentReceivedAt DateTime?
  /// The commission was paid out to the salesperson
  finalPaidAt            DateTime?
  /// Legacy global flag. Archiving is per person now (LeadArchive); the migration moved existing archives over and this is unused.
  archived               Boolean        @default(false)
  tags                   String[]       @default([])
  assignedToId           String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  assignedTo User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  bookings   Booking[]
  notes      LeadNote[]
  emails     EmailMessage[]
  documents  LeadDocument[]
  archives   LeadArchive[]
  offers     Offer[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([phone])
}

// ─── Scheduling ──────────────────────────────────────────────────────────────

/// Weekly working hours. Times are "HH:mm" in the host's timeZone.
model Availability {
  id        String @id @default(cuid())
  hostId    String
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek Int
  startTime String
  endTime   String

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([hostId, dayOfWeek, startTime])
  @@index([hostId, dayOfWeek])
}

/// Public booking page served at /book/[slug]
model BookingPage {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  description      String?  @db.Text
  durationMinutes  Int      @default(30)
  /// false = instant confirmation, true = admin must approve
  requiresApproval Boolean  @default(false)
  active           Boolean  @default(true)
  hostId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  host     User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([hostId])
}

model Booking {
  id            String        @id @default(cuid())
  status        BookingStatus @default(PENDING)
  source        BookingSource
  inviteToken   String?       @unique
  meetUrl       String?
  googleEventId String?
  startTime     DateTime
  endTime       DateTime
  title         String
  notes         String?       @db.Text
  guestName     String
  guestEmail    String
  /// team meetings: invited teammates' emails
  attendees     Json?
  hostId        String
  leadId        String?
  bookingPageId String?
  createdById   String?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  host        User            @relation("BookingHost", fields: [hostId], references: [id], onDelete: Restrict)
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingPage BookingPage?    @relation(fields: [bookingPageId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  meeting     MeetingSession?

  @@index([hostId, status, startTime])
  @@index([leadId])
  @@index([status, createdAt])
}

// ─── Agreements ──────────────────────────────────────────────────────────────

/// A document (contract, commission terms…) an admin uploaded for one salesperson. The salesperson can read their own.
model Agreement {
  id           String   @id @default(cuid())
  userId       String
  title        String
  fileName     String
  mimeType     String
  size         Int
  /// The file itself. Always select columns explicitly in lists: this can be several MB.
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Archiving ───────────────────────────────────────────────────────────────

/// "I'm done with this lead": hides it from ONE person's lists. Everyone else, and every number in the stats, is unaffected.
model LeadArchive {
  leadId    String
  userId    String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([leadId, userId])
  @@index([userId])
}

// ─── Client documents ────────────────────────────────────────────────────────

/// A file attached to one lead (contract, brief, screenshot…). Everyone who can see the lead can read and add.
model LeadDocument {
  id           String   @id @default(cuid())
  leadId       String
  title        String
  fileName     String
  mimeType     String
  size         Int
  /// The file itself. Always select columns explicitly in lists: this can be several MB.
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model ActivityLog {
  id         String     @id @default(cuid())
  entityId   String
  entityType EntityType
  /// null = system / webhook / public visitor
  actorId    String?
  action     String
  metadata   Json?
  createdAt  DateTime   @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

/// Admin-editable site/CRM settings (key → JSON value). See lib/settings.ts for known keys.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Email (Gmail sync + emails sent from the CRM) ───────────────────────────

enum EmailDirection {
  INBOUND
  OUTBOUND
}

/// One email exchanged with a contact. Only messages involving a known contact address are ever stored.
model EmailMessage {
  id              String         @id @default(cuid())
  leadId          String
  /// Whose mailbox it was found in / who sent it from the CRM
  mailboxUserId   String?
  /// "gmail:<id>" or "resend:<id>"
  externalId      String
  /// RFC 5322 Message-ID (used to thread replies sent from the CRM, and to de-duplicate across teammates' mailboxes)
  messageIdHeader String?
  /// Message-ID if present, else externalId: the same email seen in two mailboxes is stored once per contact
  dedupeKey       String
  threadId        String?
  direction       EmailDirection
  fromEmail       String
  fromName        String?
  toEmails        String[]       @default([])
  ccEmails        String[]       @default([])
  subject         String
  snippet         String
  /// Plain text, quoted history removed, capped at 20k chars
  bodyText        String         @db.Text
  sentAt          DateTime
  /// When the contact's owner first saw an inbound email in the CRM
  readAt          DateTime?
  createdAt       DateTime       @default(now())

  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mailboxUser User? @relation(fields: [mailboxUserId], references: [id], onDelete: SetNull)

  @@unique([leadId, dedupeKey])
  @@index([leadId, sentAt])
  @@index([direction, readAt])
}

/// Gmail sync bookmark per teammate.
model MailboxSync {
  userId       String    @id
  lastSyncedAt DateTime?
  lastError    String?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Google Meet tracking + Gemini notes ─────────────────────────────────────

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  NOT_HELD
}

enum NotesStatus {
  /// meeting over, looking for the Gemini notes (retried with backoff)
  WAITING
  /// notes text pulled into the CRM
  READY
  /// the notes Doc was found but could not be read (link only, retried)
  LINK_ONLY
  /// nothing appeared within 24 h
  NONE
  /// host is not on the Gemini-enabled domain
  NOT_AVAILABLE
}

/// What really happened on a CRM-scheduled Google Meet call (one per booking).
model MeetingSession {
  id               String        @id @default(cuid())
  bookingId        String        @unique
  meetingCode      String
  conferenceRecord String?
  status           MeetingStatus @default(SCHEDULED)
  actualStart      DateTime?
  actualEnd        DateTime?
  /// [{ name, joinedAt, leftAt, seconds }]
  participants     Json?
  notesStatus      NotesStatus?
  notesSource      String?
  docId            String?
  docUrl           String?
  docTitle         String?
  summaryText      String?       @db.Text
  nextStepsText    String?       @db.Text
  fullText         String?       @db.Text
  /// AI-tidied notes (OrganizedNotes JSON); null = use the free parser on fullText
  organizedJson    Json?
  notesAttempts    Int           @default(0)
  nextCheckAt      DateTime?
  notesFetchedAt   DateTime?
  lastCheckedAt    DateTime?
  lastError        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([notesStatus, nextCheckAt])
}

/// Personal calendar entries added from the Today page (reminders, calls, blocks of time).
model CalendarEntry {
  id            String   @id @default(cuid())
  ownerId       String
  title         String
  notes         String?  @db.Text
  startTime     DateTime
  endTime       DateTime
  allDay        Boolean  @default(false)
  color         String?
  googleEventId String?
  createdAt     DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, startTime])
}

// ─── Offers (client proposal microsites, admin-only for now) ─────────────────

enum OfferStatus {
  /// Being written in the local studio; only admins (and localhost) can open it
  DRAFT
  /// Published at <slug>.app.igani.co; the client can choose modules and sign
  LIVE
  /// The client signed; the page stays readable but can't be signed again
  SIGNED
  /// Taken down: the public page returns "not found"
  ARCHIVED
}

/// One proposal for one existing lead. The numbers and contract live here (entered by admins);
/// the written content and mockup screens live in the repo under offers/<slug>/ (written by Claude in the studio).
model Offer {
  id                   String      @id @default(cuid())
  /// Subdomain and folder name: honey → honey.app.igani.co and offers/honey/
  slug                 String      @unique
  leadId               String
  title                String
  status               OfferStatus @default(DRAFT)
  currency             String      @default("ILS")
  monthlyPrice         Int?
  timelineMonths       Int?
  /// Priced modules entered by an admin: [{ id, group, name, price, required, included }]
  modules              Json        @default("[]")
  /// Contract PDF the client signs (Cloudinary)
  contractUrl          String?
  contractPublicId     String?
  contractFileName     String?
  /// Contract built in the CRM (title, intro, sections), drafted with AI and edited by an admin. Used instead of an
  /// uploaded PDF once approved.
  contractDoc          Json?
  /// he | en
  contractLang         String?
  /// Approval locks the text and adds Igani's signature; the client can then sign
  contractApprovedAt   DateTime?
  contractApprovedById String?
  /// Module ids the client chose on the page (required ones are always in)
  selectedModules      String[]    @default([])
  signedAt             DateTime?
  signerName           String?
  signerEmail          String?
  signerIp             String?
  signerTitle          String?
  signerPhone          String?
  /// One-time total at the moment of signing, whole currency units
  signedTotal          Int?
  /// The signed PDF, stored on the lead as a LeadDocument
  signedDocumentId     String?
  publishedAt          DateTime?
  /// Latest call-transcript analysis (client summary, suggested modules, what was left out, open questions); feeds BUILD.md
  brief                Json?
  briefAt              DateTime?
  createdById          String?
  /// Teammates invited to work on this offer (besides its creator). Admins see every offer.
  memberIds            String[]    @default([])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  lead   Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  visits OfferVisit[]

  @@index([leadId])
  @@index([status])
}

/// One client visit to an offer page (our own Hotjar): how far they scrolled, how long each section was on screen,
/// where they clicked and where the mouse went. Positions are relative to the page section they happened in, so the
/// heatmap lines up on any screen size. Admin/teammate views are never recorded.
model OfferVisit {
  id           String   @id @default(cuid())
  offerId      String
  /// Random id the browser makes for this page load (upsert key for batched updates)
  key          String   @unique
  /// Random id kept in the browser across visits: tells repeat visits from new people
  visitorId    String
  startedAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  /// Time the page was actually visible
  durationMs   Int      @default(0)
  maxScrollPct Int      @default(0)
  /// phone | tablet | desktop
  device       String
  viewportW    Int
  viewportH    Int
  lang         String?
  country      String?
  referrer     String?
  /// Salted hash of the IP, only to rate-limit abuse
  ipHash       String
  /// { sectionId: ms on screen }
  sections     Json     @default("{}")
  /// [{ s: sectionId, x, y (0–1 inside the section), t: ms since start, l: label of what was clicked }]
  clicks       Json     @default("[]")
  /// [{ s, x, y }] sampled mouse positions
  moves        Json     @default("[]")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, startedAt])
  @@index([ipHash, startedAt])
}

/// A visit to a page on the main website (igani.co): the same measurements as OfferVisit, keyed by page
/// ("home", "realestate"). Sent by the site's tracker to /api/public/site/track; viewed under Admin → Website.
model SiteVisit {
  id           String   @id @default(cuid())
  page         String
  key          String   @unique
  visitorId    String
  startedAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  durationMs   Int      @default(0)
  maxScrollPct Int      @default(0)
  device       String
  viewportW    Int
  viewportH    Int
  lang         String?
  country      String?
  referrer     String?
  /// utm_source / utm_campaign from the landing URL, when present
  utmSource    String?
  utmCampaign  String?
  ipHash       String
  sections     Json     @default("{}")
  clicks       Json     @default("[]")
  moves        Json     @default("[]")

  @@index([page, startedAt])
  @@index([ipHash, startedAt])
}
