// Igani CRM & scheduling platform (app.igani.co)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SALES
  MARKETING
}

enum LeadSourceType {
  COLD_CALL
  ADS
  OTHER
}

enum LeadStatus {
  NEW
  /// Call results (set when an agent wraps up a call)
  NO_ANSWER
  CALL_BACK
  VOICEMAIL
  BUSY
  INTERESTED
  NOT_INTERESTED
  WRONG_NUMBER
  CONTACTED
  DEMO_SCHEDULED
  DEMO_SENT
  PROPOSAL_SENT
  /// The client signed the offer contract online; a down-payment invoice is due before it becomes Won
  SIGNED
  WON
  LOST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BookingSource {
  SALES_INVITE
  PUBLIC_PAGE
  /// internal team call (admins only), not tied to a contact
  TEAM_MEETING
}

enum EntityType {
  LEAD
  BOOKING
  USER
  ALLOWED_USER
  BOOKING_PAGE
  AVAILABILITY
  SETTING
  OFFER
}

// ─── Access control ──────────────────────────────────────────────────────────

/// Whitelist: only these emails may sign in. Role here is the source of truth.
model AllowedUser {
  id               String    @id @default(cuid())
  email            String    @unique
  role             Role
  active           Boolean   @default(true)
  /// Onboarding token emailed on invite (random, single-use)
  inviteToken      String?   @unique
  invitedAt        DateTime?
  inviteAcceptedAt DateTime?
  /// This salesperson's agreed commission terms (null = the defaults). Admin-only.
  commissionTerms  Json?
  /// When the sales agreement ended. Only deals whose client payment arrived before this date still pay commission.
  terminatedAt     DateTime?
  /// The agreement was ended immediately for an unfixable breach: the client's later payments then earn nothing. Otherwise a deal closed while engaged keeps paying.
  endedForCause    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([role, active])
}

// ─── NextAuth (Prisma adapter) ───────────────────────────────────────────────

model User {
  contractSigner     ContractSigner?
  sourcedLeads       Lead[]          @relation("LeadSourcer")
  videoAcks          VideoAck[]
  id                 String          @id @default(cuid())
  name               String?
  email              String?         @unique
  emailVerified      DateTime?
  image              String?
  role               Role?
  /// IANA zone for working hours, e.g. "Asia/Jerusalem"
  timeZone           String          @default("UTC")
  /// Round-robin cursor: rep with the oldest value gets the next lead
  lastLeadAssignedAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  accounts        Account[]
  sessions        Session[]
  assignedLeads   Lead[]          @relation("LeadAssignee")
  hostBookings    Booking[]       @relation("BookingHost")
  createdBookings Booking[]       @relation("BookingCreator")
  availability    Availability[]
  bookingPages    BookingPage[]
  calendarEntries CalendarEntry[]
  activityLogs    ActivityLog[]
  agreements      Agreement[]
  leadArchives    LeadArchive[]
  leadNotes       LeadNote[]
  phoneLine       PhoneLine?
  followUpDrafts  FollowUpDraft[]
  calls           Call[]
  chatMemberships ChatMember[]
  chatPresence    ChatPresence?
  signatures      Signature[]     @relation("UserSignatures")
  pushDevices     PushDevice[]
  chatMessages    ChatMessage[]
  chatReactions   ChatReaction[]
  createdChannels ChatChannel[]   @relation("ChatChannelCreator")
  callShares      CallShare[]     @relation("CallSharedWith")
  smsMessages     SmsMessage[]
  meetRooms       MeetRoom[]
  callLists       CallList[]
  mailboxEmails   EmailMessage[]
  mailboxSync     MailboxSync?

  @@index([role])
}

/// Google OAuth tokens live here (access_token, refresh_token, expires_at, scope)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Lead {
  id                     String         @id @default(cuid())
  /// Profile built from calls (lib/lead-intel.ts): facts with the call they came from, booked meetings, next steps
  profile                Json?
  /// Null for phone-only leads (e.g. funnel forms that only ask for a phone number)
  email                  String?        @unique
  firstName              String?
  lastName               String?
  phone                  String?
  company                String?
  website                String?
  message                String?        @db.Text
  source                 String         @default("igani.co")
  /// Free text: which page/form/campaign/person the lead came from
  sourceDetail           String?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmTerm                String?
  utmContent             String?
  budget                 String?
  status                 LeadStatus     @default(NEW)
  /// Why a lead was LOST (required when moving to LOST)
  lostReason             String?
  /// Legacy deal value (no longer read; copied into quotedPrice by the 20261103 migration)
  dealValue              Int?
  /// The price agreed with the client after the sales call, whole currency units. Admin-only.
  quotedPrice            Int?
  currency               String         @default("ILS")
  /// Where the lead came from, for commission terms (admin-edited)
  sourceType             LeadSourceType @default(OTHER)
  /// Per-deal commission overrides set by an admin before the deal is won (null = use the salesperson's terms)
  commissionOverrides    Json?
  /// Terms + breakdown used when the deal was won. Never changes when the salesperson's terms change later. Admin-only.
  commissionSnapshot     Json?
  /// The salesperson's commission in whole shekels. This, with the two payment dates, is all a salesperson ever sees.
  commissionTotal        Int?
  /// The client paid us (admin enters the date): the commission is only payable from here
  finalPaymentReceivedAt DateTime?
  /// The commission was paid out to the salesperson
  finalPaidAt            DateTime?
  /// Third-party hosting, taxes and out-of-pocket costs (whole units) taken off the price before commission is calculated. Admin-only.
  excludedCosts          Int?
  /// The client's money was returned (refund, default or dispute). A paid commission then becomes an overpayment to claw back.
  refundedAt             DateTime?
  /// Every payment the client made. Each one earns its own commission; finalPaymentReceivedAt is the day the whole price was paid.
  payments               LeadPayment[]
  /// Legacy global flag. Archiving is per person now (LeadArchive); the migration moved existing archives over and this is unused.
  archived               Boolean        @default(false)
  tags                   String[]       @default([])
  assignedToId           String?
  /// The salesperson who found this lead themselves (their own call list, dial or added contact). It stays theirs: it can't be reassigned while their agreement is active.
  sourcedById            String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  assignedTo  User?           @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  sourcedBy   User?           @relation("LeadSourcer", fields: [sourcedById], references: [id], onDelete: SetNull)
  bookings    Booking[]
  notes       LeadNote[]
  emails      EmailMessage[]
  documents   LeadDocument[]
  archives    LeadArchive[]
  offers      Offer[]
  calls       Call[]
  smsMessages SmsMessage[]
  prospects   Prospect[]
  followUps   FollowUpDraft[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([phone])
}

// ─── Scheduling ──────────────────────────────────────────────────────────────

/// Weekly working hours. Times are "HH:mm" in the host's timeZone.
model Availability {
  id        String @id @default(cuid())
  hostId    String
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek Int
  startTime String
  endTime   String

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([hostId, dayOfWeek, startTime])
  @@index([hostId, dayOfWeek])
}

/// Public booking page served at /book/[slug]
model BookingPage {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  description      String?  @db.Text
  durationMinutes  Int      @default(30)
  /// false = instant confirmation, true = admin must approve
  requiresApproval Boolean  @default(false)
  active           Boolean  @default(true)
  hostId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  host     User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([hostId])
}

model Booking {
  id            String        @id @default(cuid())
  status        BookingStatus @default(PENDING)
  source        BookingSource
  inviteToken   String?       @unique
  meetUrl       String?
  googleEventId String?
  startTime     DateTime
  endTime       DateTime
  title         String
  notes         String?       @db.Text
  guestName     String
  guestEmail    String
  /// team meetings: invited teammates' emails
  attendees     Json?
  hostId        String
  leadId        String?
  bookingPageId String?
  createdById   String?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  host        User            @relation("BookingHost", fields: [hostId], references: [id], onDelete: Restrict)
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingPage BookingPage?    @relation(fields: [bookingPageId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  meeting     MeetingSession?

  @@index([hostId, status, startTime])
  @@index([leadId])
  @@index([status, createdAt])
}

// ─── Agreements ──────────────────────────────────────────────────────────────

/// A document (contract, commission terms…) an admin uploaded for one salesperson. The salesperson can read their own.
model Agreement {
  id           String   @id @default(cuid())
  userId       String
  title        String
  fileName     String
  mimeType     String
  size         Int
  /// The file itself. Always select columns explicitly in lists: this can be several MB.
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Archiving ───────────────────────────────────────────────────────────────

/// "I'm done with this lead": hides it from ONE person's lists. Everyone else, and every number in the stats, is unaffected.
model LeadArchive {
  leadId    String
  userId    String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([leadId, userId])
  @@index([userId])
}

// ─── Client documents ────────────────────────────────────────────────────────

/// A file attached to one lead (contract, brief, screenshot…). Everyone who can see the lead can read and add.
model LeadDocument {
  id           String   @id @default(cuid())
  leadId       String
  title        String
  fileName     String
  mimeType     String
  size         Int
  /// The file itself. Always select columns explicitly in lists: this can be several MB.
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model ActivityLog {
  id         String     @id @default(cuid())
  entityId   String
  entityType EntityType
  /// null = system / webhook / public visitor
  actorId    String?
  action     String
  metadata   Json?
  createdAt  DateTime   @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

/// Who a phone number belongs to, from public references (the business's Google listing). A caller-ID directory:
/// the dialer and incoming calls show "X Real Estate" for a number no contact has yet. One Google lookup per number
/// (a miss is remembered too, and retried after 30 days).
model PhoneLabel {
  /// E.164
  number    String   @id
  /// The business at this number (null: looked up, nothing found)
  company   String?
  category  String?
  address   String?
  website   String?
  placeId   String?
  /// google
  source    String   @default("google")
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

/// Admin-editable site/CRM settings (key → JSON value). See lib/settings.ts for known keys.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Email (Gmail sync + emails sent from the CRM) ───────────────────────────

enum EmailDirection {
  INBOUND
  OUTBOUND
}

/// One email exchanged with a contact. Only messages involving a known contact address are ever stored.
model EmailMessage {
  id              String         @id @default(cuid())
  leadId          String
  /// Whose mailbox it was found in / who sent it from the CRM
  mailboxUserId   String?
  /// "gmail:<id>" or "resend:<id>"
  externalId      String
  /// RFC 5322 Message-ID (used to thread replies sent from the CRM, and to de-duplicate across teammates' mailboxes)
  messageIdHeader String?
  /// Message-ID if present, else externalId: the same email seen in two mailboxes is stored once per contact
  dedupeKey       String
  threadId        String?
  direction       EmailDirection
  fromEmail       String
  fromName        String?
  toEmails        String[]       @default([])
  ccEmails        String[]       @default([])
  subject         String
  snippet         String
  /// Plain text, quoted history removed, capped at 20k chars
  bodyText        String         @db.Text
  sentAt          DateTime
  /// When the contact's owner first saw an inbound email in the CRM
  readAt          DateTime?
  /// Sent from the CRM, waiting for an answer: the reminder task, when it's due, and when they replied
  followUpTaskId  String?
  followUpAt      DateTime?
  repliedAt       DateTime?
  createdAt       DateTime       @default(now())

  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mailboxUser User? @relation(fields: [mailboxUserId], references: [id], onDelete: SetNull)

  @@unique([leadId, dedupeKey])
  @@index([leadId, sentAt])
  @@index([direction, readAt])
  @@index([leadId, direction, repliedAt])
}

/// Gmail sync bookmark per teammate.
model MailboxSync {
  userId       String    @id
  lastSyncedAt DateTime?
  lastError    String?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Google Meet tracking + Gemini notes ─────────────────────────────────────

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  NOT_HELD
}

enum NotesStatus {
  /// meeting over, looking for the Gemini notes (retried with backoff)
  WAITING
  /// notes text pulled into the CRM
  READY
  /// the notes Doc was found but could not be read (link only, retried)
  LINK_ONLY
  /// nothing appeared within 24 h
  NONE
  /// host is not on the Gemini-enabled domain
  NOT_AVAILABLE
}

/// What really happened on a CRM-scheduled Google Meet call (one per booking).
model MeetingSession {
  id               String        @id @default(cuid())
  bookingId        String        @unique
  meetingCode      String
  conferenceRecord String?
  status           MeetingStatus @default(SCHEDULED)
  actualStart      DateTime?
  actualEnd        DateTime?
  /// [{ name, joinedAt, leftAt, seconds }]
  participants     Json?
  notesStatus      NotesStatus?
  notesSource      String?
  docId            String?
  docUrl           String?
  docTitle         String?
  summaryText      String?       @db.Text
  nextStepsText    String?       @db.Text
  fullText         String?       @db.Text
  /// AI-tidied notes (OrganizedNotes JSON); null = use the free parser on fullText
  organizedJson    Json?
  notesAttempts    Int           @default(0)
  nextCheckAt      DateTime?
  notesFetchedAt   DateTime?
  lastCheckedAt    DateTime?
  lastError        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([notesStatus, nextCheckAt])
}

/// Personal calendar entries added from the Today page (reminders, calls, blocks of time).
model CalendarEntry {
  id            String   @id @default(cuid())
  ownerId       String
  title         String
  notes         String?  @db.Text
  startTime     DateTime
  endTime       DateTime
  allDay        Boolean  @default(false)
  color         String?
  googleEventId String?
  createdAt     DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, startTime])
}

// ─── Offers (client proposal microsites, admin-only for now) ─────────────────

enum OfferStatus {
  /// Being written in the local studio; only admins (and localhost) can open it
  DRAFT
  /// Published at <slug>.app.igani.co; the client can choose modules and sign
  LIVE
  /// The client signed; the page stays readable but can't be signed again
  SIGNED
  /// Taken down: the public page returns "not found"
  ARCHIVED
}

/// One proposal for one existing lead. The numbers and contract live here (entered by admins);
/// the written content and mockup screens live in the repo under offers/<slug>/ (written by Claude in the studio).
model Offer {
  id                   String      @id @default(cuid())
  /// Subdomain and folder name: honey → honey.app.igani.co and offers/honey/
  slug                 String      @unique
  leadId               String
  title                String
  status               OfferStatus @default(DRAFT)
  currency             String      @default("ILS")
  monthlyPrice         Int?
  timelineMonths       Int?
  /// Priced modules entered by an admin: [{ id, group, name, price, required, included }]
  modules              Json        @default("[]")
  /// Contract PDF the client signs (Cloudinary)
  contractUrl          String?
  contractPublicId     String?
  contractFileName     String?
  /// Contract built in the CRM (title, intro, sections), drafted with AI and edited by an admin. Used instead of an
  /// uploaded PDF once approved.
  contractDoc          Json?
  /// he | en
  contractLang         String?
  /// Approval locks the text and adds Igani's signature; the client can then sign
  contractApprovedAt   DateTime?
  contractApprovedById String?
  /// Who signed for Igani when the contract was approved (a copy of the saved signature, so later edits don't change it)
  contractSigner       Json?
  /// Module ids the client chose on the page (required ones are always in)
  selectedModules      String[]    @default([])
  signedAt             DateTime?
  signerName           String?
  signerEmail          String?
  signerIp             String?
  signerTitle          String?
  signerPhone          String?
  /// One-time total at the moment of signing, whole currency units
  signedTotal          Int?
  /// The signed PDF, stored on the lead as a LeadDocument
  signedDocumentId     String?
  publishedAt          DateTime?
  /// Latest call-transcript analysis (client summary, suggested modules, what was left out, open questions); feeds BUILD.md
  brief                Json?
  briefAt              DateTime?
  createdById          String?
  /// Teammates invited to work on this offer (besides its creator). Admins see every offer.
  memberIds            String[]    @default([])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  lead   Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  visits OfferVisit[]

  @@index([leadId])
  @@index([status])
}

/// One client visit to an offer page (our own Hotjar): how far they scrolled, how long each section was on screen,
/// where they clicked and where the mouse went. Positions are relative to the page section they happened in, so the
/// heatmap lines up on any screen size. Admin/teammate views are never recorded.
model OfferVisit {
  id           String   @id @default(cuid())
  offerId      String
  /// Random id the browser makes for this page load (upsert key for batched updates)
  key          String   @unique
  /// Random id kept in the browser across visits: tells repeat visits from new people
  visitorId    String
  startedAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  /// Time the page was actually visible
  durationMs   Int      @default(0)
  maxScrollPct Int      @default(0)
  /// phone | tablet | desktop
  device       String
  viewportW    Int
  viewportH    Int
  lang         String?
  country      String?
  referrer     String?
  /// Salted hash of the IP, only to rate-limit abuse
  ipHash       String
  /// { sectionId: ms on screen }
  sections     Json     @default("{}")
  /// [{ s: sectionId, x, y (0–1 inside the section), t: ms since start, l: label of what was clicked }]
  clicks       Json     @default("[]")
  /// [{ s, x, y }] sampled mouse positions
  moves        Json     @default("[]")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, startedAt])
  @@index([ipHash, startedAt])
}

/// A visit to a page on the main website (igani.co): the same measurements as OfferVisit, keyed by page
/// ("home", "realestate"). Sent by the site's tracker to /api/public/site/track; viewed under Admin → Website.
model SiteVisit {
  id           String   @id @default(cuid())
  page         String
  key          String   @unique
  visitorId    String
  startedAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  durationMs   Int      @default(0)
  maxScrollPct Int      @default(0)
  device       String
  viewportW    Int
  viewportH    Int
  lang         String?
  country      String?
  referrer     String?
  /// utm_source / utm_campaign from the landing URL, when present
  utmSource    String?
  utmCampaign  String?
  ipHash       String
  sections     Json     @default("{}")
  clicks       Json     @default("[]")
  moves        Json     @default("[]")

  @@index([page, startedAt])
  @@index([ipHash, startedAt])
}

enum CallDirection {
  OUTBOUND
  INBOUND
}

enum CallStatus {
  /// created by the CRM, Twilio not reached yet
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  BUSY
  NO_ANSWER
  FAILED
  CANCELED
}

/// A teammate's Twilio number: the caller id for their calls (and, from step 2, where their calls ring).
model PhoneLine {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// E.164, e.g. +972501234567
  number    String   @unique
  /// Twilio IncomingPhoneNumber SID (PN...), when picked from the account
  twilioSid String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SmsDirection {
  INBOUND
  OUTBOUND
}

/// A text message to or from a teammate's line (the Messages tab of the dialer). Threads are per line and other number.
model SmsMessage {
  id          String       @id @default(cuid())
  /// Whose line it went through (null if that teammate was removed: the company keeps the record)
  userId      String?
  /// The contact with that number, when there is one
  leadId      String?
  direction   SmsDirection
  /// Our line and the other party, both E.164
  lineNumber  String
  otherNumber String
  body        String       @db.Text
  /// Pictures or files sent with an incoming message (count only; open them in Twilio)
  media       Int          @default(0)
  twilioSid   String?      @unique
  /// queued | sending | sent | delivered | undelivered | failed | received
  status      String
  error       String?
  /// When the teammate opened an incoming message
  readAt      DateTime?
  createdAt   DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId, otherNumber, createdAt])
  @@index([userId, direction, readAt])
  @@index([leadId, createdAt])
}

/// One phone call made (or, from step 2, received) in the CRM. See docs/DIALER.md.
model Call {
  id               String        @id @default(cuid())
  /// Who made the call (kept as empty if the teammate is deleted: company call records stay)
  userId           String?
  leadId           String?
  direction        CallDirection
  status           CallStatus    @default(INITIATED)
  /// The user's line and the other party, both E.164
  fromNumber       String
  toNumber         String
  /// The browser leg (parent) and the phone leg (child) in Twilio
  twilioCallSid    String?       @unique
  childCallSid     String?
  startedAt        DateTime      @default(now())
  answeredAt       DateTime?
  endedAt          DateTime?
  /// Talk time once answered (seconds)
  durationSec      Int?
  recordingSid     String?
  recordingStatus  String?
  recordingSec     Int?
  /// Wrap-up chosen after the call: connected, voicemail, no_answer, busy, wrong_number, callback, not_interested
  outcome          String?
  notes            String?
  /// Analysis of the recording: pending → processing → ready | failed | skipped (see lib/call-analysis.ts)
  analysisStatus   String?
  /// Whisper segments: [{ start, end, text, speaker: 'rep' | 'client' }]
  transcript       Json?
  /// Summary, outcome, objections, action items, scores and coaching moments (CallAnalysis)
  analysis         Json?
  analyzedAt       DateTime?
  analysisError    String?
  analysisAttempts Int           @default(0)
  /// true for calls made in the development demo mode (never in production)
  simulated        Boolean       @default(false)
  /// A call to a business on a call list (before it is a lead)
  prospectId       String?
  /// Calls placed through a Twilio conference room (Settings → Phone → Allow listening in), so admins can listen in
  conferenceSid    String?
  conference       Boolean       @default(false)
  /// What the AI learned about the client on this call (lib/lead-intel.ts): person, company, site, meeting, next steps
  intel            Json?
  /// A personal call (admins only): not recorded, not reviewed, not tied to a contact, and only its caller can see it
  private          Boolean       @default(false)

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead     Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  prospect Prospect?   @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  shares   CallShare[]

  @@index([userId, startedAt])
  @@index([leadId, startedAt])
  @@index([prospectId])
}

/// An admin adds a salesman to someone else's call so he can open it (recording, transcript, review) from his own Calls list.
/// It is only visible to him: it is NOT counted in his call numbers or average score.
model CallShare {
  callId     String
  userId     String
  sharedById String?
  createdAt  DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User @relation("CallSharedWith", fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
  @@index([userId])
}

// ─── Call lists (cold calling) ───────────────────────────────────────────────

enum ProspectStatus {
  TO_CALL
  CALLBACK
  CONVERTED
  NOT_INTERESTED
  BAD_NUMBER
}

/// Businesses to cold-call (e.g. from "Find businesses"). A prospect becomes a lead when a call goes well.
model CallList {
  id        String   @id @default(cuid())
  name      String
  /// Who calls this list (null if that teammate was removed: admins can still see it)
  ownerId   String?
  /// The Google search it came from, if any
  query     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  prospects Prospect[]

  @@index([ownerId, createdAt])
}

model Prospect {
  id           String         @id @default(cuid())
  listId       String
  /// Google place id (dedupe within a list)
  placeId      String?
  name         String
  phone        String
  website      String?
  address      String?
  category     String?
  rating       Float?
  reviews      Int?
  mapsUrl      String?
  status       ProspectStatus @default(TO_CALL)
  /// Calls made to it from the list
  attempts     Int            @default(0)
  lastCalledAt DateTime?
  /// Last wrap-up outcome (see CALL_OUTCOMES)
  lastOutcome  String?
  notes        String?        @db.Text
  /// Everything else we found: opening hours (Google), and from its website: other phones, emails, WhatsApp,
  /// social pages, named contacts with roles, a short summary (see lib/prospect-details.ts)
  details      Json?
  /// Website lookup: pending → processing → done | failed | none (no website)
  enrichStatus String?
  enrichedAt   DateTime?
  /// The lead it became
  leadId       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  list  CallList @relation(fields: [listId], references: [id], onDelete: Cascade)
  lead  Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  calls Call[]

  @@unique([listId, placeId])
  @@index([listId, status])
  @@index([phone])
}

/// Igani Meet (admin Tests tab): a video room on Jitsi (8x8 JaaS), with invites for teammates and outside emails.
model MeetRoom {
  id           String          @id @default(cuid())
  /// the room name on Jitsi and in links (/meet/<code>): random, unguessable
  code         String          @unique
  title        String
  hostId       String?
  scheduledAt  DateTime?
  durationMin  Int             @default(30)
  endedAt      DateTime?
  /// last time anyone was in the call (open call tabs check in every 20 s); the room closes on its own after it's empty
  lastActiveAt DateTime?
  createdAt    DateTime        @default(now())
  host         User?           @relation(fields: [hostId], references: [id], onDelete: SetNull)
  invites      MeetInvite[]
  recordings   MeetRecording[]
  presence     MeetPresence[]

  @@index([hostId, createdAt])
}

/// One person invited to a room. The token in their link lets them in; teammates are linked by userId.
model MeetInvite {
  id        String    @id @default(cuid())
  roomId    String
  email     String
  name      String?
  userId    String?
  token     String    @unique
  sentAt    DateTime?
  sendError String?
  joinedAt  DateTime?
  createdAt DateTime  @default(now())
  room      MeetRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, email])
}

/// The record that a commission agreement was signed (who, which wording, when, from where, the figures). The signed PDF itself is NOT stored: it is emailed to both parties.
model AgreementAcceptance {
  id         String   @id @default(cuid())
  /// The representative's email as written in the agreement (matches User / AllowedUser by email)
  email      String
  /// Which wording they signed (CONTRACT_VERSION in lib/sales-contract-core.ts)
  version    String
  /// SHA-256 of the signed sections
  sha256     String
  /// The filled-in terms: figures and legal terms, as signed
  terms      Json
  signerName String
  adminName  String
  adminEmail String
  ip         String
  userAgent  String
  signedAt   DateTime
  createdAt  DateTime @default(now())

  @@index([email, signedAt])
}

/// An admin's signature for commission agreements (one per admin). Any admin can pick which of them signs a contract.
model ContractSigner {
  userId    String   @id
  name      String
  title     String   @default("")
  /// PNG data URL of the drawn signature
  signature String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A cloud recording of an Igani Meet call. 8x8 records, then tells us (webhook) where to download it for 24 hours;
/// we copy it to our own storage (Cloudinary, private) so it stays.
model MeetRecording {
  id           String    @id @default(cuid())
  roomId       String
  /// 8x8's recordingSessionId (one per start/stop): makes the webhook idempotent
  sessionId    String    @unique
  status       String    @default("processing") /// processing | ready | failed
  startedAt    DateTime?
  durationSec  Int?
  /// 8x8's pre-authenticated download link and when it stops working (24h)
  sourceUrl    String?
  sourceUntil  DateTime?
  publicId     String?
  bytes        Int?
  error        String?
  participants Json?
  createdAt    DateTime  @default(now())
  room         MeetRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

/// Who is in a call right now (each open call tab checks in every ~20s), so the lobby can say "Dana is in the call".
model MeetPresence {
  id     String   @id @default(cuid())
  roomId String
  /// random per browser tab
  key    String
  name   String
  /// teammates' photo (set by the server from their account, never from the browser)
  avatar String?
  seenAt DateTime @default(now())
  room   MeetRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, key])
  @@index([roomId, seenAt])
}

/// A teammate confirmed, before starting an internal training video, that they will not download or share it.
model VideoAck {
  id        String   @id @default(cuid())
  userId    String
  /// The video's id (videos live in site settings, so this is a plain id, not a relation)
  videoId   String
  ip        String
  userAgent String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, videoId, createdAt])
}

/// One payment from the client on a won deal. The commission on it is fixed when it is recorded and is payable as it arrives.
model LeadPayment {
  id               String    @id @default(cuid())
  leadId           String
  /// Whole currency units the client paid
  amount           Int
  receivedAt       DateTime
  /// The salesperson's commission on this payment (whole units), fixed when recorded
  commission       Int
  /// When that commission was paid out to the salesperson
  commissionPaidAt DateTime?
  /// When this payment was returned to the client (a paid commission is then clawed back)
  refundedAt       DateTime?
  /// The client has now paid the whole price (matters when payments arrive in another currency and the shekel total drifts from the locked shekel price)
  isFinal          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

enum ChatKind {
  CHANNEL
  DM
}

/// Team chat: a channel (public to the whole team, or private to its members) or a direct conversation.
model ChatChannel {
  id            String    @id @default(cuid())
  kind          ChatKind  @default(CHANNEL)
  /// lowercase, dashes (e.g. "sales-floor"); empty for direct conversations
  name          String    @default("")
  topic         String?
  /// private channels are seen only by their members; public ones by everyone on the team
  private       Boolean   @default(false)
  /// direct conversations: the members' ids, sorted and joined, so each pair has one conversation
  dmKey         String?   @unique
  createdById   String?
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  archivedAt    DateTime?

  createdBy User?         @relation("ChatChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ChatMember[]
  messages  ChatMessage[]

  @@index([kind, lastMessageAt])
}

model ChatMember {
  channelId  String
  userId     String
  joinedAt   DateTime @default(now())
  /// everything before this is read
  lastReadAt DateTime @default(now())
  /// no unread counts or notifications from this channel (mentions still come through)
  muted      Boolean  @default(false)

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id          String    @id @default(cuid())
  channelId   String
  /// kept as empty if the teammate is deleted
  userId      String?
  body        String
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?
  /// anything that changes how it looks (edit, delete, reaction, a reply): what polling asks for
  updatedAt   DateTime  @default(now())
  /// a reply in a thread: the message it answers (threads are one level deep)
  parentId    String?
  replyCount  Int       @default(0)
  lastReplyAt DateTime?
  /// files and images: [{ publicId, kind: image|file, name, bytes, mime, width?, height? }] (Cloudinary, private)
  attachments Json?

  channel   ChatChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent    ChatMessage?   @relation("ChatThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ChatMessage[]  @relation("ChatThread")
  reactions ChatReaction[]

  @@index([channelId, createdAt])
  @@index([channelId, updatedAt])
  @@index([parentId, createdAt])
}

model ChatReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

/// An iPhone that gets push notifications for this user (the app registers its APNs token after sign-in).
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  /// APNs device token (hex)
  token      String   @unique
  /// "sandbox" for development builds, "production" for TestFlight / App Store
  env        String   @default("production")
  /// which notifications this phone wants: { chat, texts, calls, leads } (missing = on)
  prefs      Json?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A signature Igani can sign with (Settings → Signatures): sales contracts and offer contracts pick one.
model Signature {
  id          String    @id @default(cuid())
  /// the admin who signs with it: their name and email come from their profile
  userId      String?
  user        User?     @relation("UserSignatures", fields: [userId], references: [id], onDelete: SetNull)
  /// how it's listed ("Gabriel · CEO")
  label       String
  name        String
  title       String    @default("")
  email       String    @default("")
  phone       String    @default("")
  /// PNG data URL of the signature
  image       String
  isDefault   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  @@index([userId])
}

/// Who's around in team chat: last seen (online dot) and typing (where, when). One row per person.
model ChatPresence {
  userId          String    @id
  seenAt          DateTime  @default(now())
  typingChannelId String?
  typingThreadId  String?
  typingAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One OpenAI request: what it was for and what it used (lib/ai-usage.ts). Admin → Phone shows the monthly totals.
model AiUsage {
  id           String   @id @default(cuid())
  /// call-review, transcription, tonality, live-hints, live-transcription, contract, offer, offer-transcript, meeting, site-audit, prospect
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// part of inputTokens OpenAI served from its cache (billed cheaper)
  cachedTokens Int      @default(0)
  /// transcription billed by the minute (whisper-1)
  audioSeconds Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// A follow-up the assistant drafted for a conversation that went quiet (lib/follow-ups.ts). The salesperson edits and
/// sends it from Today, or dismisses it; its task closes either way.
model FollowUpDraft {
  id        String    @id @default(cuid())
  leadId    String
  /// who it's for: the contact's owner when it was drafted
  userId    String
  /// the task on the contact that points to it
  taskId    String
  /// email | sms
  channel   String
  subject   String?
  body      String    @db.Text
  /// why it was drafted, in one line ("They asked for a quote on 3 Nov and haven't heard back")
  reason    String
  /// unanswered | promise | quiet | reminder (the branded meeting reminder, sent to the guest once approved)
  kind      String
  /// the meeting a reminder is for
  bookingId String?
  /// open | sent | dismissed
  status    String    @default("open")
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([leadId, createdAt])
}
