{
  "name": "igani-crm",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && node scripts/migrate-on-deploy.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "studio": "node scripts/studio.mjs",
    "studio:install": "node scripts/studio-install.mjs",
    "studio:uninstall": "node scripts/studio-install.mjs --uninstall",
    "offer:push": "node scripts/offer-push.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "^1.5.0",
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/gmail": "^22.0.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/components": "^0.0.36",
    "@react-email/render": "^1.0.6",
    "@sparticuz/chromium": "^153.0.0",
    "@tanstack/react-table": "^8.21.3",
    "@twilio/voice-sdk": "2.18.5",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.65.0",
    "next": "^16.4.5",
    "next-auth": "^4.24.15",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.16.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "resend": "^4.8.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "twilio": "6.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
