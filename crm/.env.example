# Postgres for the CRM (separate from the marketing site's database)
DATABASE_URL="postgresql://user:pass@host:5432/igani_crm"
# NextAuth
NEXTAUTH_URL="https://app.igani.co"
NEXTAUTH_SECRET="openssl rand -hex 32"
# Google OAuth client (Web). Redirect URI: https://app.igani.co/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Resend (domain igani.co verified)
RESEND_API_KEY=""
EMAIL_FROM="Igani <bookings@igani.co>"
# Shared secret igani.co sends in the x-api-key header (min 16 chars)
LEAD_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="https://app.igani.co"
# Task-reminder cron (Vercel sends it as "Authorization: Bearer <value>"). Min 16 chars; without it the endpoint returns 401.
CRON_SECRET=""
# Optional
INVITE_TOKEN_SECRET=""
ADMIN_NOTIFY_EMAIL=""

# Dev/QA only (ignored in production builds): enables email login at /api/auth/signin for whitelisted users
# DEV_LOGIN=1
